# ========================================================
# Claude Code -> NVIDIA NIM Middleware Configuration
# ========================================================

# Get your free key from: https://build.nvidia.com (NVIDIA NIM)
NVIDIA_API_KEY=nvapi-your-key-here

# Target NVIDIA base URL (OpenAI compatible endpoint)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Default model to use when Claude Code requests sonnet/opus/haiku

DEFAULT_MODEL=nvidia/nemotron-3-ultra-550b-a55b

MODEL_SONNET=nvidia/nemotron-3.5-super-vl-120b-a12b
MODEL_HAIKU=nvidia/nemotron-3-ultra-550b-a55b
MODEL_OPUS=nvidia/nemotron-3-ultra-550b-a55b

# Middleware server settings
PORT=8080
HOST=127.0.0.1
LOG_LEVEL=info

